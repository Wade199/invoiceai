# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (Google Gemini, free tier) ---
GOOGLE_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./data/invoiceai.db

# --- Upload security (see PROJECT_BRIEF.md §5.1) ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf

# --- RGPD (see PROJECT_BRIEF.md §5.2) ---
DEFAULT_RETENTION_DAYS=30

# --- Gemini free tier: measured 2026-09-20 = 20 requests PER DAY per model (not 15/min) ---
GEMINI_RATE_LIMIT_PER_MINUTE=15

# --- Extraction cache (SHA-256 of PDF -> JSON) ---
CACHE_DIR=data/cache

# --- PDF parsing limits (DoS protection) ---
MAX_PDF_PAGES=30
MAX_PDF_TEXT_CHARS=100000
MAX_PDF_SECONDS=20

# --- Gemini plan: free | paid (free = fake data only outside EEA/CH/UK, see docs/security) ---
GEMINI_TIER=free

# --- Cache encryption + retention (generate the key: python scripts/generate_cache_key.py) ---
CACHE_ENCRYPTION_KEY=
CACHE_TTL_DAYS=30

# --- Optional: pick another Gemini model (each model has its own free daily quota) ---
# GEMINI_MODEL=gemini-flash-latest

# --- API (V1 = one local user): listen on 127.0.0.1 only, protected by a bearer token ---
# Generate the token: python scripts/generate_api_token.py   (32 characters minimum)
API_TOKEN=
UPLOAD_DIR=data/uploads
MAX_CONCURRENT_EXTRACTIONS=2
UPLOAD_RATE_LIMIT_PER_MINUTE=10
